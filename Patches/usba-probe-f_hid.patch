--- a/drivers/usb/gadget/function/f_hid.c
+++ b/drivers/usb/gadget/function/f_hid.c
@@ -548,6 +548,7 @@
 
 static int f_hidg_release(struct inode *inode, struct file *fd)
 {
+	pr_info("usba probe: hidg release\n");
 	fd->private_data = NULL;
 	return 0;
 }
@@ -558,6 +559,7 @@
 	struct f_hidg *hidg =
 		container_of(parent, struct f_hidg, dev.kobj);
 
+	dev_info(&hidg->dev, "usba probe: hidg open %s\n", dev_name(&hidg->dev));
 	fd->private_data = hidg;
 
 	return 0;
@@ -1012,6 +1014,8 @@
 	if (status)
 		goto fail_free_descs;
 
+	dev_info(&hidg->dev, "usba probe: hidg bind %s kref=%u\n",
+		 dev_name(&hidg->dev), kref_read(&hidg->dev.kobj.kref));
 	return 0;
 fail_free_descs:
 	usb_free_all_descriptors(f);
@@ -1253,6 +1257,8 @@
 {
 	struct f_hidg *hidg = func_to_hidg(f);
 
+	dev_info(&hidg->dev, "usba probe: hidg unbind %s kref=%u\n",
+		 dev_name(&hidg->dev), kref_read(&hidg->dev.kobj.kref));
 	cdev_device_del(hidg->cdev, &hidg->dev);
 
 	usb_free_all_descriptors(f);
