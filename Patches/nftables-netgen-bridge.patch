diff --git a/net/netfilter/nft_chain_nat.c b/net/netfilter/nft_chain_nat.c
index eac4a9012..0e4e10091 100644
--- a/net/netfilter/nft_chain_nat.c
+++ b/net/netfilter/nft_chain_nat.c
@@ -1,6 +1,9 @@
 // SPDX-License-Identifier: GPL-2.0
 
 #include <linux/module.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
 #include <linux/netfilter/nf_tables.h>
 #include <net/netfilter/nf_nat.h>
 #include <net/netfilter/nf_tables.h>
@@ -75,14 +78,77 @@ static const struct nft_chain_type nft_chain_nat_ipv6 = {
 #endif
 
 #ifdef CONFIG_NF_TABLES_INET
+/*
+ * The stock kernel does not build nf_nat_inet_register_fn() (it requires
+ * CONFIG_NF_TABLES_INET built into the kernel).  Register the inet nat chain
+ * by giving the exported per-family helpers a pf-corrected copy of the
+ * chain's nf_hook_ops and registering on IPv4 and IPv6.  The copies must
+ * outlive registration (nf_hook_entries stores the ops pointer), so they are
+ * tracked per original ops pointer and freed on unregister.
+ */
+struct nft_nat_inet_entry {
+	struct nf_hook_ops		v4;
+	struct nf_hook_ops		v6;
+	struct hlist_node		node;
+	const struct nf_hook_ops	*orig;
+};
+
+static DEFINE_MUTEX(nft_nat_inet_lock);
+static HLIST_HEAD(nft_nat_inet_entries);
+
 static int nft_nat_inet_reg(struct net *net, const struct nf_hook_ops *ops)
 {
-	return nf_nat_inet_register_fn(net, ops);
+	struct nft_nat_inet_entry *e;
+	int ret;
+
+	e = kzalloc(sizeof(*e), GFP_KERNEL);
+	if (!e)
+		return -ENOMEM;
+
+	e->v4 = *ops;
+	e->v4.pf = NFPROTO_IPV4;
+	e->v6 = *ops;
+	e->v6.pf = NFPROTO_IPV6;
+	e->orig = ops;
+
+	ret = nf_nat_ipv4_register_fn(net, &e->v4);
+	if (ret < 0)
+		goto err;
+
+	ret = nf_nat_ipv6_register_fn(net, &e->v6);
+	if (ret < 0) {
+		nf_nat_ipv4_unregister_fn(net, &e->v4);
+		goto err;
+	}
+
+	mutex_lock(&nft_nat_inet_lock);
+	hlist_add_head(&e->node, &nft_nat_inet_entries);
+	mutex_unlock(&nft_nat_inet_lock);
+
+	return 0;
+err:
+	kfree(e);
+	return ret;
 }
 
 static void nft_nat_inet_unreg(struct net *net, const struct nf_hook_ops *ops)
 {
-	nf_nat_inet_unregister_fn(net, ops);
+	struct nft_nat_inet_entry *e = NULL;
+
+	mutex_lock(&nft_nat_inet_lock);
+	hlist_for_each_entry(e, &nft_nat_inet_entries, node) {
+		if (e->orig == ops) {
+			hlist_del(&e->node);
+			break;
+		}
+	}
+	mutex_unlock(&nft_nat_inet_lock);
+
+	if (e && e->orig == ops) {
+		nf_nat_ipv4_unregister_fn(net, &e->v4);
+		nf_nat_ipv6_unregister_fn(net, &e->v6);
+		kfree(e);
+	}
 }
 
