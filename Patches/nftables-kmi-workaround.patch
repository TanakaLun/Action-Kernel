diff --git a/include/net/net_namespace.h b/include/net/net_namespace.h
index 82cfc5006..d4fd6c4e4 100644
--- a/include/net/net_namespace.h
+++ b/include/net/net_namespace.h
@@ -142,9 +142,6 @@ struct net {
 #if defined(CONFIG_NF_CONNTRACK) || defined(CONFIG_NF_CONNTRACK_MODULE)
 	struct netns_ct		ct;
 #endif
-#if defined(CONFIG_NF_TABLES) || defined(CONFIG_NF_TABLES_MODULE)
-	struct netns_nftables	nft;
-#endif
 #if IS_ENABLED(CONFIG_NF_DEFRAG_IPV6)
 	struct netns_nf_frag	nf_frag;
 	struct ctl_table_header *nf_frag_frags_hdr;
@@ -196,6 +193,34 @@ struct net {
 /* Init's network namespace */
 extern struct net init_net;
 
+/*
+ * KMI workaround: struct net is part of the frozen vendor ABI, so the
+ * nftables per-net data cannot be embedded in it (adding the field shifts
+ * net->gen and everything after it, breaking genksyms CRCs of ~2700
+ * exported symbols and therefore every prebuilt vendor module).
+ *
+ * Keep it in a container allocated by net_alloc() instead, the same
+ * approach AOSP uses for CONFIG_NETFILTER_FAMILY_BRIDGE.
+ */
+struct ext_net {
+	struct net net;
+#if IS_ENABLED(CONFIG_NF_TABLES)
+	struct netns_nftables nft;
+#endif
+};
+
+#if IS_ENABLED(CONFIG_NF_TABLES)
+extern struct netns_nftables init_net_nft;
+
+static inline struct netns_nftables *nft_netns(const struct net *net)
+{
+	if (net == &init_net)
+		return &init_net_nft;
+	return (struct netns_nftables *)
+		&container_of(net, const struct ext_net, net)->nft;
+}
+#endif
+
 #ifdef CONFIG_NET_NS
 struct net *copy_net_ns(unsigned long flags, struct user_namespace *user_ns,
 			struct net *old_net);
diff --git a/include/net/netfilter/nf_tables.h b/include/net/netfilter/nf_tables.h
index cb13e604d..c01e71d8f 100644
--- a/include/net/netfilter/nf_tables.h
+++ b/include/net/netfilter/nf_tables.h
@@ -1349,7 +1349,7 @@ void nft_trace_notify(struct nft_traceinfo *info);
  */
 static inline unsigned int nft_gencursor_next(const struct net *net)
 {
-	return net->nft.gencursor + 1 == 1 ? 1 : 0;
+	return nft_netns(net)->gencursor + 1 == 1 ? 1 : 0;
 }
 
 static inline u8 nft_genmask_next(const struct net *net)
@@ -1360,7 +1360,7 @@ static inline u8 nft_genmask_next(const struct net *net)
 static inline u8 nft_genmask_cur(const struct net *net)
 {
 	/* Use READ_ONCE() to prevent refetching the value for atomicity */
-	return 1 << READ_ONCE(net->nft.gencursor);
+	return 1 << READ_ONCE(nft_netns(net)->gencursor);
 }
 
 #define NFT_GENMASK_ANY		((1 << 0) | (1 << 1))
